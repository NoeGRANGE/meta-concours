# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / solution files regenerated by Unity
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.unityproj

# Build outputs and signing material
*.apk
*.aab
*.unitypackage
*.keystore
*.jks
crashlytics-build.properties
sysinfo.txt

# Secrets (OAuth client config, tokens)
*.secret.json
client_secret*.json

# OS
.DS_Store
Thumbs.db

# Input action bindings the Meta XR Core SDK writes on Play and before builds
/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json.meta

# Temporary files of Unity Android builds
.utmp/

# Sound proposals are regenerated by SourceArt/sounds/generate_sounds.py
SourceArt/sounds/*.wav

# Headset recordings for the video, too large for git
Captures/

# Music renders are regenerated by SourceArt/music/compose_music.py
SourceArt/music/*.wav

# Android signing keys: never in git, keep a backup elsewhere (every future update must be signed with it)
*.keystore
*.jks
SourceArt/music/ecoute.html
